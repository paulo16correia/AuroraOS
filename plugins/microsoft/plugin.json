        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "effects": [],
      "risk": "LOW",
      "approval_required": false,
      "reversible": false,
      "rate_limit_per_minute": 30,
      "timeout_seconds": 5,
      "idempotent": true,
      "audit_level": "FULL"
    },
