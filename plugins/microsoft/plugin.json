{
  "plugin_id": "plugin/microsoft",
  "version": "0.1.0",
  "publisher": "aurora",
  "executable": "microsoft_service.py",
  "min_platform_version": 1,
  "max_data_class": "PRIVATE",
  "documentation_ref": "docs/integrations/microsoft.md",
  "required_permissions": [
    "microsoft.identity.read",
    "microsoft.mail.read",
    "microsoft.mail.write",
    "microsoft.mail.send",
    "microsoft.calendar.read",
    "microsoft.calendar.write"
  ],
  "event_subscriptions": [],
  "network_endpoints": [
    "graph.microsoft.com",
    "login.microsoftonline.com"
  ],
  "service": {
    "start_timeout_seconds": 20,
    "max_consecutive_failures": 5
  },
  "required_secrets": [
    {
      "name": "tenant_id",
      "purpose": "Which Microsoft 365 organisation to sign in to. Not a secret in the usual sense, and kept here so every part of the sign-in lives in one place."
    },
    {
      "name": "client_id",
      "purpose": "The Entra application registration Aurora signs in as. Public identifier of the app you created."
    },
    {
      "name": "refresh_token",
      "purpose": "Acts as you, with the permissions you consented to. Anything Aurora does with Microsoft is done as you and is attributable to you. Obtained once by running device_login.py yourself; Aurora never asks for your password."
    }
  ],
  "requires_gpu": false,
  "capabilities": [
    {
      "key": "microsoft.status",
      "title": "Microsoft connection status",
      "description": "Whether this machine could reach Microsoft 365 at all, and what is missing if not. Answers without contacting Microsoft, so it is safe to ask before anything has been approved.",
