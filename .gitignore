
# Build / deps (adjust to stack once code lands)
# Editors
# Env / secrets
# OS
*.local
*.log
*.pyc
*.swp
*~
.DS_Store
.env
.env.*
.idea/
.vscode/
Thumbs.db
__pycache__/
bin/
build/
desktop.ini
dist/
node_modules/
obj/
plugins/*/config.json
plugins/discord/bin/
plugins/discord/models/
# Everything vendored except Aurora's own. The compiled library does not belong in history; the
# speech client is a copy of plugins/voice/speech.py, and a checkout without it is a Discord plugin
# that will not start. Written as vendor/* rather than vendor/ because git does not look inside a
# directory it has already excluded, so nothing below it could be let back in.
plugins/discord/vendor/*
!plugins/discord/vendor/__init__.py
!plugins/discord/vendor/aurora_voice/
plugins/discord/vendor/aurora_voice/__pycache__/

# Runtime state and operator secrets. The real deployment lives outside this tree
# (%LOCALAPPDATA%\Aurora on Windows, ~/.local/share/aurora elsewhere), so these are
# defensive: they keep a key or a database out of history if anyone ever points a
# data root at the checkout.
*.db
*.db-shm
*.db-wal
*.db.anchor
*.key
*.pem
*.pfx
*.p12
aurora.passphrase.json
bearer.txt
*.token
secrets.json
sandbox/

# Third-party speech engines and voice models are downloaded, not authored here.
# (plugins/discord/{bin,models,vendor} are already excluded above.)
*.onnx
*.onnx.json
ggml-*.bin
piper.exe
whisper-cli.exe

# Temporary
*.tmp
*.bak
*.orig
