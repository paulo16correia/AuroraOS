# TLS termination for Aurora (RFC 12 rule 1).
#
# Replace aurora.example.com with the controlled name for this instance. Caddy obtains and renews
# the certificate itself; there is no manual step to forget.

aurora.example.com {
	encode gzip

	# Liveness is the only thing served without a credential, and it says one word.
	handle /health/live {
		reverse_proxy aurora:8080
	}

	handle {
		reverse_proxy aurora:8080 {
			header_up X-Forwarded-Proto {scheme}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		# Logs are operational. They do not replace the audit journal and must not be treated as
		# one (rule 4): the journal is signed and chained, and this is not.
		output stdout
		format json
	}
}
