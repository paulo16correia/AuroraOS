<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aurora.Server</RootNamespace>

    <!--
      The plugins live under this project and are not part of it. They are separate programs Aurora
      launches, in another language, confined; nothing here compiles, embeds or publishes them.

      Excluded from the globs rather than removed from the item lists afterwards, because the cost
      being avoided is the enumeration: 509 files and 2.4 GB of speech models and engine binaries sit
      in there, and the SDK would walk all of it on every build and every restore to decide it wants
      none of it.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);plugins\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <!-- Embedded rather than served from disk: a panel that could be changed by editing a file
         next to the binary would be a way to put arbitrary script in front of an operator who is
         about to approve something. -->
    <EmbeddedResource Include="Ui/index.html" />
    <EmbeddedResource Include="Ui/app.css" />
    <EmbeddedResource Include="Ui/app.js" />
    <EmbeddedResource Include="Ui/login.html" />
    <EmbeddedResource Include="Ui/login.js" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Aurora.Core/Aurora.Core.csproj" />
    <ProjectReference Include="../Aurora.Adapters/Aurora.Adapters.csproj" />
  </ItemGroup>
</Project>
